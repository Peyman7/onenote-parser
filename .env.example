# Copy to .env and fill in real values. `.env` is gitignored; this file is not.
#   cp .env.example .env
# The CLI auto-loads ./.env, or pass --env-file /path/to/file.

# --- Identity ---------------------------------------------------------------
ONENOTE_TENANT_ID=00000000-0000-0000-0000-000000000000
ONENOTE_CLIENT_ID=11111111-1111-1111-1111-111111111111
# Only needed for auth.mode=refresh_token / client_credentials (confidential client).
ONENOTE_CLIENT_SECRET=
# Obtain once with: onenote-parser login --print-refresh-token
ONENOTE_REFRESH_TOKEN=
# device_code (interactive, cached) | refresh_token (headless) | static
ONENOTE_AUTH_MODE=device_code

# Alternative: bring your own bearer token (auth.mode=static)
# ONENOTE_ACCESS_TOKEN=

# --- What to read -----------------------------------------------------------
# me | users/<id-or-upn> | groups/<id> | sites/<id>
ONENOTE_TARGET=me

# --- Where to write ---------------------------------------------------------
ONENOTE_OUTPUT_DIR=output
ONENOTE_STATE_PATH=state/onenote-state.json

# --- Behaviour --------------------------------------------------------------
ONENOTE_OCR_ENABLED=false
ONENOTE_LOG_LEVEL=INFO

# Any setting can be overridden with ONENOTE_PARSER__<section>__<key>:
# ONENOTE_PARSER__graph__requests_per_minute=120
# ONENOTE_PARSER__runtime__concurrency=8
